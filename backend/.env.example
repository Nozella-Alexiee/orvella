# Copy to backend/.env and fill in.
ORVELLA_DATABASE_URL=postgresql+psycopg://orvella:CHANGE_ME@localhost:5432/orvella
ORVELLA_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to true when served over HTTPS
ORVELLA_COOKIE_SECURE=false
# Only used by scripts/setup_postgres.py to create the role and database
ORVELLA_PG_SUPERUSER_PASSWORD=
# Masuk dengan Google (development: redirect URI http://localhost:5173/api/auth/google/callback)
ORVELLA_GOOGLE_CLIENT_ID=
ORVELLA_GOOGLE_CLIENT_SECRET=
# Kosong = alamat diambil dari request (di Vite: http://localhost:5173)
ORVELLA_PUBLIC_URL=
