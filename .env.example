# Settings for docker compose. scripts/tunnel.ps1 and scripts/tunnel.sh create .env with random values automatically.
POSTGRES_PASSWORD=ganti-dengan-string-acak
SECRET_KEY=ganti-dengan-string-acak-yang-panjang
# Password for all demo accounts (sekar@, dimas@, nadia@ … @smksig.sch.id). Keep it secret when the app is public.
DEMO_PASSWORD=ganti-dengan-password-demo
# Port on this computer
APP_PORT=8000
# Use "http2" if your network blocks QUIC/UDP and the tunnel never connects
TUNNEL_PROTOCOL=auto
COOKIE_SECURE=true
# Runner (sandbox kode), proxy pratinjau proyek web, dan MariaDB untuk proyek PHP + MySQL
RUNNER_TOKEN=ganti-dengan-string-acak-minimal-16
PREVIEW_SECRET=ganti-dengan-string-acak-minimal-16
MYSQL_ROOT_PASSWORD=ganti-dengan-string-acak
# Port pratinjau proyek web di komputer ini (origin terpisah dari aplikasi)
PREVIEW_PORT=8301
# Alamat publik pratinjau kalau aplikasi di balik HTTPS sendiri (mis. https://preview.sekolah.sch.id). Kosongkan untuk LAN/tunnel.
PREVIEW_PUBLIC_URL=
# Batas untuk mesin kecil: container kode yang boleh jalan bersamaan, dan proyek web yang boleh menyala bersamaan
MAX_RUN_CONCURRENCY=2
MAX_WS_SESSIONS=3
